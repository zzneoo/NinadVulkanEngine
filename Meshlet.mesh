#version 460

#extension GL_EXT_mesh_shader : require
#extension GL_EXT_shader_8bit_storage : require

layout(local_size_x = 32) in;

layout(max_vertices = 64, max_primitives = 126) out;

struct VertexData
{
    vec3 pos;
    vec2 texCoord;
    vec3 normal;
    vec3 tangent;
};

struct MeshletData
{
    uint vertexOffset;
    uint triangleOffset;
    uint vertexCount;
    uint triangleCount;
};


layout(set = 0, binding = 0, std140) uniform FrameData
{
    mat4 view;
    mat4 proj;

    float fTime;
    uint frameID;

    vec2 pad0;

    vec3 cameraPos;
    float pad1;
} frameData;


layout(set = 1, binding = 0, std430) readonly buffer MeshletBuffer
{
    MeshletData meshlets[];
};

layout(set = 1, binding = 1, std430) readonly buffer MeshletVertexBuffer
{
    uint meshletVertices[];
};

layout(set = 1, binding = 2, std430) readonly buffer MeshletTriangleBuffer
{
    uint8_t meshletTriangles[];
};


layout(set = 1, binding = 3, std430) readonly buffer VertexBuffer
{
    VertexData vertices[];
};

// Output primitive type
layout(triangles) out;

// Per-vertex outputs
layout(location = 0) out vec3 outColor[];

void main()
{
    uint meshletID = gl_WorkGroupID.x;

    MeshletData meshlet = meshlets[meshletID];

    SetMeshOutputsEXT(meshlet.vertexCount, meshlet.triangleCount);

    // Load meshlet vertices
    // --------------------------------------------------------

    for (uint i = gl_LocalInvocationID.x; i < meshlet.vertexCount; i += gl_WorkGroupSize.x)
    {
        uint originalVertexIndex = meshletVertices[meshlet.vertexOffset + i];

        VertexData vertex = vertices[originalVertexIndex];

        vec4 worldPosition = vec4(vertex.pos, 1.0);

        vec4 viewPosition = frameData.view * worldPosition;

        gl_MeshVerticesEXT[i].gl_Position =frameData.proj * frameData.view * worldPosition;


        // Temporary visualization.
        //
        // Later this becomes your normal/PBR pipeline.
        outColor[i] =
            vertex.normal * 0.5 + 0.5;
    }


    // Load meshlet triangles
    // --------------------------------------------------------

    for (uint i = gl_LocalInvocationID.x; i < meshlet.triangleCount; i += gl_WorkGroupSize.x)
    {
        uint triangleBase = meshlet.triangleOffset + i * 3;

        uint i0 = uint(meshletTriangles[triangleBase + 0]);
        uint i1 = uint(meshletTriangles[triangleBase + 1]);
        uint i2 = uint(meshletTriangles[triangleBase + 2]);

        gl_PrimitiveTriangleIndicesEXT[i] = uvec3(i0, i1, i2);
    }

}
