#version 460

#extension GL_EXT_mesh_shader : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(local_size_x = 32) in;
layout(max_vertices = 64, max_primitives = 126) out;

taskPayloadSharedEXT uint meshletID;

struct VertexData
{
    vec4 pos;
    vec4 texCoord;
    vec4 normal;
    vec4 tangent;
};

struct ModelData
{
    mat4 modelMatrix;
    float maxScale;
    float pad[3];
};

struct MeshletData
{
    uint vertexOffset;
    uint triangleOffset;

    uint vertexCount;
    uint triangleCount;

    vec4 bounds;

    uint modelIndex;
	uint pad0;
	uint pad1;
	uint pad2;
};


layout(set = 0, binding = 0, std140) uniform FrameData
{
    mat4 view;
    mat4 proj;

    float fTime;
    uint frameID;

    vec2 pad0;

    vec3 cameraPos;
    float pad1;

    vec4 frustumPlanes[6];

} frameData;

layout(push_constant) uniform MeshletPushConstants
{
    uint64_t meshletDataAddress;
    uint64_t meshletVerticesAddress;
    uint64_t meshletTrianglesAddress;
    uint64_t verticesAddress;
    uint64_t modelDataAddress;
} pc;


layout(buffer_reference, std430)
readonly buffer MeshletDataBuffer
{
    MeshletData data[];
};

layout(buffer_reference, std430)
readonly buffer MeshletVertexBuffer
{
    uint data[];
};

layout(buffer_reference, std430)
readonly buffer MeshletTriangleBuffer
{
    uint8_t data[];
};

layout(buffer_reference, std430)
readonly buffer VertexBuffer
{
    VertexData data[];
};

layout(buffer_reference, std430)
readonly buffer ModelDataBuffer
{
    ModelData data[];
};


// Output primitive type
layout(triangles) out;

// Per-vertex outputs
layout(location = 0) out vec4 outNormal[];
layout(location = 1) out vec4 outColor[];

vec3 MeshletColor(uint id)
{
    uint x = id;

    x ^= x >> 17;
    x *= 0xed5ad4bbU;
    x ^= x >> 11;
    x *= 0xac4c1b51U;
    x ^= x >> 15;
    x *= 0x31848babU;
    x ^= x >> 14;

    return vec3(
        float(x & 255U) / 255.0,
        float((x >> 8) & 255U) / 255.0,
        float((x >> 16) & 255U) / 255.0);
}

void main()
{


    MeshletDataBuffer meshlets = MeshletDataBuffer(pc.meshletDataAddress);
    MeshletVertexBuffer meshletVertices = MeshletVertexBuffer(pc.meshletVerticesAddress);
    MeshletTriangleBuffer meshletTriangles = MeshletTriangleBuffer(pc.meshletTrianglesAddress);
    VertexBuffer vertices = VertexBuffer(pc.verticesAddress);
    ModelDataBuffer models = ModelDataBuffer(pc.modelDataAddress);


    MeshletData meshlet = meshlets.data[meshletID];
    mat4 ModelMatrix = models.data[meshlet.modelIndex].modelMatrix;

    SetMeshOutputsEXT(meshlet.vertexCount, meshlet.triangleCount);
    // Load meshlet vertices
    // --------------------------------------------------------

    for (uint i = gl_LocalInvocationID.x; i < meshlet.vertexCount; i += gl_WorkGroupSize.x)
    {
        //uint originalVertexIndex = meshletVertices[meshlet.vertexOffset + i];
        //VertexData vertex = vertices[originalVertexIndex];

        uint originalVertexIndex = meshletVertices.data[ meshlet.vertexOffset + i];
        VertexData vertex = vertices.data[originalVertexIndex];

        vec4 worldPosition = ModelMatrix * vec4(vertex.pos.xyz, 1.0);

        gl_MeshVerticesEXT[i].gl_Position =frameData.proj * frameData.view * worldPosition;


        // Temporary visualization.
        //
        // Later this becomes your normal/PBR pipeline.
        outNormal[i] = vertex.normal * 0.5 + 0.5;
        outColor[i] = vec4(MeshletColor(meshletID),1.0);

    }


    // Load meshlet triangles
    // --------------------------------------------------------

    for (uint i = gl_LocalInvocationID.x; i < meshlet.triangleCount; i += gl_WorkGroupSize.x)
    {
        uint triangleBase = meshlet.triangleOffset + i * 3;

        uint i0 = uint(meshletTriangles.data[triangleBase + 0]);
        uint i1 = uint(meshletTriangles.data[triangleBase + 1]);
        uint i2 = uint(meshletTriangles.data[triangleBase + 2]);

        gl_PrimitiveTriangleIndicesEXT[i] = uvec3(i0, i1, i2);
    }

}
