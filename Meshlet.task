#version 460

#extension GL_EXT_mesh_shader : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(local_size_x = 1) in;

taskPayloadSharedEXT uint meshletID;


layout(set = 0, binding = 0, std140) uniform FrameData
{
    mat4 view;
    mat4 proj;

    float fTime;
    uint frameID;

    vec2 pad0;

    vec3 cameraPos;
    float pad1;

    vec4 frustumPlanes[6];

} frameData;

struct MeshletData
{
    uint vertexOffset;
    uint triangleOffset;

    uint vertexCount;
    uint triangleCount;

    vec4 bounds;    // xyz = center, w = radius
    vec4 coneAxis;   // xyz = axis, w = cutoff
    vec4 coneApex;     // xyz apex

    uint modelIndex;    
    uint materialID;          
    uint pad1;         
    uint pad2;         

};

struct ModelData
{
    mat4 modelMatrix;
    float maxScale;
    float pad[3];
};

layout(buffer_reference, std430)
readonly buffer MeshletDataBuffer
{
    MeshletData data[];
};

layout(buffer_reference, std430)
readonly buffer ModelDataBuffer
{
    ModelData data[];
};

layout(push_constant) uniform MeshletPushConstants
{
    uint64_t meshletDataAddress;
    uint64_t meshletVerticesAddress;
    uint64_t meshletTrianglesAddress;
    uint64_t verticesAddress;
    uint64_t modelDataAddress;
} pc;


bool IsSphereVisible(vec3 center, float radius)
{
    for (int i = 0; i < 6; ++i)
    {
        vec4 plane = frameData.frustumPlanes[i];
        float distance = dot(plane.xyz, center) + plane.w;

        if (distance < -radius)
            return false;
    }

    return true;
}


void main()
{


    // Meshlet ID
    // --------------------------------------------------------
    uint id = gl_WorkGroupID.x;


    // Convert device address -> buffer reference
    // --------------------------------------------------------
    MeshletDataBuffer meshlets = MeshletDataBuffer(pc.meshletDataAddress);

    // --------------------------------------------------------
    // Load this meshlet
    // --------------------------------------------------------
    MeshletData meshlet = meshlets.data[id];


    // --------------------------------------------------------
    // Model matrix from Global buffer
    // --------------------------------------------------------
    ModelDataBuffer models = ModelDataBuffer(pc.modelDataAddress);
    ModelData mData = models.data[meshlet.modelIndex];

    mat4 modelMatrix = mData.modelMatrix;
    float maxScale = mData.maxScale;

    // --------------------------------------------------------
    // Bounding sphere
    // --------------------------------------------------------
    vec3 localCenter = meshlet.bounds.xyz;
    float localRadius = meshlet.bounds.w;

    vec3 worldCenter = (modelMatrix * vec4(localCenter, 1.0)).xyz;
    float worldRadius = localRadius * maxScale-4.0;

    // --------------------------------------------------------
    // Frustum culling
    // --------------------------------------------------------
    bool isNotVisible = !IsSphereVisible(worldCenter,worldRadius);
    if (isNotVisible){return;}

    // --------------------------------------------------------
    // Cone culling
    // --------------------------------------------------------
    vec3 worldConeAxis = normalize( mat3(modelMatrix) * meshlet.coneAxis.xyz);
    vec3 worldConeApex = (modelMatrix *vec4(meshlet.coneApex.xyz, 1.0)).xyz;

    vec3 toCamera = normalize(frameData.cameraPos - worldConeApex);
    float coneCutoff = meshlet.coneAxis.w;

    bool coneBackface = dot(worldConeAxis, toCamera) >= coneCutoff * 0.9;// remove *0.9 if meshlets pop. 1.0 is 100% backkfacing meshlet

    if (coneBackface) 
    return;


    // --------------------------------------------------------
    // Visible meshlet
    // --------------------------------------------------------
    meshletID = id;

    EmitMeshTasksEXT(1,1,1);
}

