#version 460

#extension GL_GOOGLE_include_directive : require

#include "common.glsl"

struct VoxelCloudDensitySamples
{
    float mProfile;
    float mFull;
    float mDimensionalProfile;

};

#define saturate(x) clamp(x, 0.0, 1.0)

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 1, binding = 0, rgba8) uniform writeonly image2D outputImage;
layout(set = 1, binding = 1) uniform sampler3D noise3D;
layout(set = 1, binding = 2) uniform sampler3D modelingData3D;
layout(set = 1, binding = 3) uniform sampler3D accumulatedOpticalDepth3D;

layout(push_constant) uniform PushConstants 
{
	vec3 v3LightColor;
	float fCloudFactor;
	vec4 fIntensity;
} pc;

const vec3 VOLUME_MIN  = vec3(-2048.0, -2048.0, -256.0);
const vec3 VOLUME_SIZE = vec3(4096.0, 4096.0, 512.0);
const vec3 VOLUME_MAX  = VOLUME_MIN + VOLUME_SIZE;
const float DENSITY_SCALE = 1.0;


// ------------------------------------------------------------
// Value Remap
// Maps a value from [oldMin, oldMax] to [newMin, newMax]
// The normalized value is clamped to [0, 1]
// ------------------------------------------------------------

float ValueRemap(
    float inValue,
    float inOldMin,
    float inOldMax,
    float inMin,
    float inMax)
{
    float oldMinMaxRange =
        inOldMax - inOldMin;

    float normalized =
        clamp(
            (inValue - inOldMin) /
            oldMinMaxRange,
            0.0,
            1.0);

    return inMin +
        normalized *
        (inMax - inMin);
}


vec2 ValueRemap(
    vec2 inValue,
    vec2 inOldMin,
    vec2 inOldMax,
    vec2 inMin,
    vec2 inMax)
{
    vec2 oldMinMaxRange =
        inOldMax - inOldMin;

    vec2 normalized =
        clamp(
            (inValue - inOldMin) /
            oldMinMaxRange,
            vec2(0.0),
            vec2(1.0));

    return inMin +
        normalized *
        (inMax - inMin);
}


vec3 ValueRemap(
    vec3 inValue,
    vec3 inOldMin,
    vec3 inOldMax,
    vec3 inMin,
    vec3 inMax)
{
    vec3 oldMinMaxRange =
        inOldMax - inOldMin;

    vec3 normalized =
        clamp(
            (inValue - inOldMin) /
            oldMinMaxRange,
            vec3(0.0),
            vec3(1.0));

    return inMin +
        normalized *
        (inMax - inMin);
}


vec4 ValueRemap(
    vec4 inValue,
    vec4 inOldMin,
    vec4 inOldMax,
    vec4 inMin,
    vec4 inMax)
{
    vec4 oldMinMaxRange =
        inOldMax - inOldMin;

    vec4 normalized =
        clamp(
            (inValue - inOldMin) /
            oldMinMaxRange,
            vec4(0.0),
            vec4(1.0));

    return inMin +
        normalized *
        (inMax - inMin);
}


// ------------------------------------------------------------
// Value Erosion
// Positive inOldMin = erosion
// Negative inOldMin = inflation
// ------------------------------------------------------------

float ValueErosion(
    float inValue,
    float inOldMin)
{
    float oldMinMaxRange =
        1.0 - inOldMin;

    float normalized =
        clamp(
            (inValue - inOldMin) /
            oldMinMaxRange,
            0.0,
            1.0);

    return normalized;
}

vec3 WorldToVolumeUV(vec3 worldPos, vec3 VolumeMin, vec3 VolumeMax)
{
    // Remap world position from range [VolumeMin, VolumeMax] -> [0.0, 1.0]
    return (worldPos - VolumeMin) / (VolumeMax - VolumeMin);
}

bool IntersectAABB(
    vec3 rayOrigin,
    vec3 rayDir,
    vec3 boxMin,
    vec3 boxMax,
    out float tEnter,
    out float tExit)
{
    vec3 invRayDir = 1.0 / rayDir;

    vec3 t0 = (boxMin - rayOrigin) * invRayDir;
    vec3 t1 = (boxMax - rayOrigin) * invRayDir;
    vec3 tMin = min(t0, t1);
    vec3 tMax = max(t0, t1);

    tEnter = max(max(tMin.x, tMin.y), tMin.z);
    tExit = min( min(tMax.x, tMax.y), tMax.z);
    tEnter = max(tEnter, 0.0);
    return tExit >= tEnter;
}


VoxelCloudDensitySamples SampleDensity(vec3 worldPos)
{
    vec3 volumeUV =
        (worldPos - VOLUME_MIN) /
        (VOLUME_MAX - VOLUME_MIN);


    vec3 modelingData = texture(modelingData3D,volumeUV).xyz;
   	VoxelCloudDensitySamples density_samples;

    if(modelingData.r>0.0)
    {
        density_samples.mProfile = modelingData.r * modelingData.b;
        density_samples.mDimensionalProfile = modelingData.r;


        vec4 noise = texture(noise3D, worldPos * 0.01).xyzw;

        // Define wispy noise
	    float wispy_noise = mix(noise.r, noise.g, modelingData.r);

        // Define billowy noise 
        float billowy_type_gradient = pow(modelingData.r, 0.25);
        float billowy_noise = mix(noise.b * 0.3, noise.a * 0.3, billowy_type_gradient);

        // Define Noise composite - blend to wispy as the density scale decreases.
        float noise_composite = mix(wispy_noise, billowy_noise, modelingData.g);


        float uprezzed_density = ValueErosion(modelingData.r, noise_composite);

        // Apply User Density Scale Data to Result
        float powered_density_scale = pow(saturate(modelingData.b),4.0);

        uprezzed_density *= powered_density_scale;

        // Sharpen result and lower Density close to camera to both add details and reduce undersampling noise
        uprezzed_density = pow(uprezzed_density, mix(0.3, 0.6, max(1e-6, powered_density_scale)));

        density_samples.mFull = uprezzed_density;
    }
    else
    {
        density_samples.mFull = density_samples.mProfile = 0.0;
    }


    return density_samples;
}



float SampleSunTransmittance(
    vec3 worldPos,
    vec3 sunDir)
{
    float tEnter;
    float tExit;

    if (!IntersectAABB(
            worldPos,
            sunDir,
            VOLUME_MIN,
            VOLUME_MAX,
            tEnter,
            tExit))
    {
        return 1.0;
    }
    const float LIGHT_STEP_SIZE = 2.0;
    const int LIGHT_MAX_STEPS = 16;

    // Accumulate total optical depth instead of calculating exp() per step
    float accumulatedOpticalDepth = 0.0;

    // Threshold equivalent to lightTransmittance < 0.01 (-ln(0.01) ≈ 4.605)
    const float MAX_OPTICAL_DEPTH = 4.60517;

    float t = 0.0;

    for (int i = 0; i < LIGHT_MAX_STEPS && t < tExit; ++i)
    {
        float currentStep = min(LIGHT_STEP_SIZE, tExit - t);
        vec3 samplePos = worldPos + sunDir * (t + currentStep * 0.5);

        // IMPORTANT: samplePos, not worldPos
        VoxelCloudDensitySamples density_samples = SampleDensity(samplePos);

        float density = density_samples.mFull;
        float sigmaT = density * DENSITY_SCALE;

        // Fast float addition per step
        accumulatedOpticalDepth += sigmaT * currentStep;

        // Early break equivalent to lightTransmittance < 0.01
        if (accumulatedOpticalDepth > MAX_OPTICAL_DEPTH)
            break;

        t += currentStep;
    }

    vec3 volumeUV = WorldToVolumeUV(worldPos, VOLUME_MIN, VOLUME_MAX);

    float farOpticalDepth = texture(accumulatedOpticalDepth3D,volumeUV).r;

    // Evaluate Beer's Law ONCE at the end
    return exp(-(accumulatedOpticalDepth + farOpticalDepth));
}



float PhaseHenyeyGreenstein(
    float cosTheta,
    float g)
{
    const float INV_4PI = 0.0795774715;

    float g2 = g * g;

    float denom =
        1.0 + g2 -
        2.0 * g * cosTheta;

    float invSqrtDenom =
        inversesqrt(denom);

    return
        INV_4PI *
        (1.0 - g2) *
        invSqrtDenom *
        invSqrtDenom *
        invSqrtDenom;
}

vec3 TonemapACES(vec3 x)
{
	const float a = 2.51;
	const float b = 0.03;
	const float c = 2.43;
	const float d = 0.59;
	const float e = 0.14;
	return clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0, 1.0);
}



void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);

    if (pixel.x >= size.x || pixel.y >= size.y)
        return;


    // --------------------------------------------------
    // Reconstruct world-space ray
    // --------------------------------------------------

    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    vec2 ndc = uv * 2.0 - 1.0;

    vec4 worldFar = global.inverseViewProj * vec4(ndc, 1.0, 1.0);
    worldFar.xyz /= worldFar.w;

    vec3 rayOrigin = global.cameraPos;
    vec3 rayDir = normalize(worldFar.xyz - rayOrigin);


    float tEnter;
    float tExit;

    float transmittance = 1.0;
    vec3 scattering = vec3(0.0);

    if (IntersectAABB(
            rayOrigin,
            rayDir,
            VOLUME_MIN,
            VOLUME_MAX,
            tEnter,
            tExit))
    {
        const float STEP_SIZE = 2.0;
        const int MAX_STEPS = 512;

        float t = tEnter + STEP_SIZE * 0.5;
        // Precompute outside the loop to free instruction slots and registers
        vec3 sunDir = normalize(global.sunDir);

        for (int i = 0; i < MAX_STEPS && t < tExit; ++i)
        {
            vec3 worldPos = rayOrigin + rayDir * t;
            VoxelCloudDensitySamples density_samples = SampleDensity(worldPos);

            float density = density_samples.mFull;

            // Empty space
            if (density > 0.0001)
            {
                float sigmaT = density * DENSITY_SCALE;
                float sunTransmittance = SampleSunTransmittance(worldPos,sunDir);
                float cosTheta = dot(rayDir, sunDir);
                float phase = PhaseHenyeyGreenstein(cosTheta,0.6);
                float sigmaS = sigmaT;

                // Isotropic phase function for uniform sky light (1.0 / 4PI)
                float ambientPhase = 0.079577;
                float ambientOcclusion = exp(-density * 0.132 *10.0);//skipped for now

                vec3 directLight = pc.v3LightColor * pc.fIntensity.x * sunTransmittance * phase;
                //vec3 ambientLight = pc.v3LightColor * ambientOcclusion * ambientPhase; // Ambient light contribution
                float ambientLight = sqrt(max(1.0 -density_samples.mDimensionalProfile,0.0)) * ambientPhase;

                vec3 S =  sigmaS * (directLight + ambientLight);

                float deltaTrans = exp(-sigmaT * STEP_SIZE);
                float sintWeight = (1.0 - deltaTrans) / max(sigmaT, 1e-6);
                scattering += transmittance * S * sintWeight;
                transmittance *= deltaTrans;
            }

            if (transmittance < 0.01)
                break;

            t += STEP_SIZE;
        }
    }


    // --------------------------------------------------
    // Visualize density
    // --------------------------------------------------

    float opacity = 1.0 - transmittance;
    opacity = clamp(opacity, 0.0, 1.0);

    scattering = TonemapACES(scattering);

    imageStore(outputImage, pixel, vec4(vec3(scattering), 1.0)
    );
}
