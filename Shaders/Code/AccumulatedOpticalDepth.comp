#version 460

#extension GL_GOOGLE_include_directive : require

#include "common.glsl"

struct VoxelCloudDensitySamples
{
    float mProfile;
    float mFull;
    float mDimensionalProfile;
};

layout(local_size_x = 8, local_size_y = 8, local_size_z = 4) in;

layout(set = 1, binding = 0, r16f) uniform writeonly image3D accumulatedOpticalDepth3D;
layout(set = 1, binding = 1) uniform sampler3D noise3D;
layout(set = 1, binding = 2) uniform sampler3D modelingData3D;

const vec3 VOLUME_MIN  = vec3(-2048.0, -2048.0, -256.0);
const vec3 VOLUME_SIZE = vec3(4096.0, 4096.0, 512.0);
const vec3 VOLUME_MAX  = VOLUME_MIN + VOLUME_SIZE;

const float MAIN_PASS_LIGHT_STEP_SIZE = 4.0;
const int   MAIN_PASS_LIGHT_MAX_STEPS = 8;
const float MAIN_PASS_OFFSET = float(MAIN_PASS_LIGHT_MAX_STEPS) * MAIN_PASS_LIGHT_STEP_SIZE;

const float LIGHT_STEP_SIZE = 16.0;
const int   LIGHT_MAX_STEPS = 32;


const float DENSITY_SCALE = 1.0;
const float MAX_OPTICAL_DEPTH = 4.60517;


float ValueErosion(
    float inValue,
    float inOldMin)
{
    float oldMinMaxRange = 1.0 - inOldMin;

    float normalized =clamp((inValue - inOldMin) /oldMinMaxRange,0.0,1.0);

    return normalized;
}

// Ray-AABB intersection returning tEnter and tExit
bool IntersectAABB(
    vec3 rayOrigin,
    vec3 rayDir,
    vec3 boxMin,
    vec3 boxMax,
    out float tEnter,
    out float tExit)
{
    vec3 invRayDir = 1.0 / rayDir;

    vec3 t0 = (boxMin - rayOrigin) * invRayDir;
    vec3 t1 = (boxMax - rayOrigin) * invRayDir;
    vec3 tMin = min(t0, t1);
    vec3 tMax = max(t0, t1);

    tEnter = max(max(tMin.x, tMin.y), tMin.z);
    tExit = min( min(tMax.x, tMax.y), tMax.z);
    tEnter = max(tEnter, 0.0);
    return tExit >= tEnter;
}

VoxelCloudDensitySamples SampleDensity(vec3 worldPos)
{
    VoxelCloudDensitySamples density_samples;
    density_samples.mFull = 0.0;
    density_samples.mProfile = 0.0;
    density_samples.mDimensionalProfile = 0.0;

    vec3 volumeUV = (worldPos - VOLUME_MIN) / VOLUME_SIZE;

    // Bounds check to avoid sampler wrap/clamp artifacts
    if (any(lessThan(volumeUV, vec3(0.0))) || any(greaterThan(volumeUV, vec3(1.0))))
    {
        return density_samples;
    }

    vec3 modelingData = texture(modelingData3D, volumeUV).xyz;

    if (modelingData.r > 0.0)
    {
        density_samples.mProfile = modelingData.r * modelingData.b;
        density_samples.mDimensionalProfile = modelingData.r;

        vec4 noise = texture(noise3D, worldPos * 0.015).xyzw;

        float wispy_noise = mix(noise.r, noise.g, modelingData.r);
        float billowy_type_gradient = pow(modelingData.r, 0.25);
        float billowy_noise = mix(noise.b * 0.3, noise.a * 0.3, billowy_type_gradient);

        float noise_composite = mix(wispy_noise, billowy_noise, modelingData.g);
        float uprezzed_density = ValueErosion(modelingData.r, noise_composite);

        float powered_density_scale = pow(saturate(modelingData.b), 4.0);
        uprezzed_density *= powered_density_scale;
        uprezzed_density = pow(uprezzed_density, mix(0.3, 0.6, max(1e-6, powered_density_scale)));

        density_samples.mFull = uprezzed_density;
    }

    return density_samples;
}

void main()
{
    ivec3 voxel = ivec3(gl_GlobalInvocationID);
    ivec3 size  = imageSize(accumulatedOpticalDepth3D);

    if (any(greaterThanEqual(voxel, size)))
        return;

    vec3 voxelCenterWorld = VOLUME_MIN + (vec3(voxel) + 0.5) * 16.0;//to map 4096x4096x512
    vec3 sunDir = normalize(global.sunDir);

    // Ray origin starts after primary pass steps
    vec3 rayStartPos = voxelCenterWorld + sunDir * MAIN_PASS_OFFSET;

    // Clip ray against volume AABB
    float tEnter, tExit;
    if (!IntersectAABB(rayStartPos, sunDir, VOLUME_MIN, VOLUME_MAX, tEnter, tExit))
    {
        // Ray does not intersect the remaining volume space
        imageStore(accumulatedOpticalDepth3D, voxel, vec4(0.0));
        return;
    }

    // Start marching from the valid volume entry point (or rayStartPos if already inside)
    float t = max(tEnter, 0.0);
    float accumOpticalDepth = 0.0;

    for (int i = 0; i < LIGHT_MAX_STEPS; ++i)
    {
        if (t >= tExit)
            break;

        vec3 samplePos = rayStartPos + sunDir * (t + LIGHT_STEP_SIZE * 0.5);

        VoxelCloudDensitySamples density_samples = SampleDensity(samplePos);

        float density = density_samples.mFull;
        float sigmaT  = density * DENSITY_SCALE;

        accumOpticalDepth += sigmaT * LIGHT_STEP_SIZE;

        if (accumOpticalDepth >= MAX_OPTICAL_DEPTH)
        {
            accumOpticalDepth = MAX_OPTICAL_DEPTH;
            break;
        }

        t += LIGHT_STEP_SIZE;
    }

    imageStore(accumulatedOpticalDepth3D, voxel, vec4(accumOpticalDepth, 0.0, 0.0, 0.0));
}