#version 460

#extension GL_GOOGLE_include_directive : require

#include "common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 1, binding = 0, rgba8) uniform writeonly image2D outputImage;
layout(set = 1, binding = 1) uniform sampler3D noise3D;
layout(set = 1, binding = 2) uniform sampler3D modelingData3D;



bool IntersectAABB(
    vec3 rayOrigin,
    vec3 rayDir,
    vec3 boxMin,
    vec3 boxMax,
    out float tEnter,
    out float tExit)
{
    vec3 invRayDir = 1.0 / rayDir;

    vec3 t0 =
        (boxMin - rayOrigin) * invRayDir;

    vec3 t1 =
        (boxMax - rayOrigin) * invRayDir;

    vec3 tMin =
        min(t0, t1);

    vec3 tMax =
        max(t0, t1);

    tEnter =
        max(
            max(tMin.x, tMin.y),
            tMin.z);

    tExit =
        min(
            min(tMax.x, tMax.y),
            tMax.z);

    tEnter = max(tEnter, 0.0);

    return tExit >= tEnter;
}

float SampleDensity(
    vec3 worldPos,
    vec3 sphereCenter,
    float sphereRadius)
{
    vec3 volumeUV = (worldPos - sphereCenter) / (2.0 * sphereRadius) + 0.5;

    float density = texture(noise3D, volumeUV).r;

    // Normalize distance between 0.0 and 1.0 relative to sphere radius
    float distNorm = distance(worldPos, sphereCenter) / sphereRadius;
    float falloff = smoothstep(1.0, 0.4, distNorm);

    return density * falloff;
}

const vec3 VOLUME_MIN  = vec3(-256.0, -256.0, -32.0);
const vec3 VOLUME_SIZE = vec3(512.0, 512.0, 64.0);
const vec3 VOLUME_MAX  = VOLUME_MIN + VOLUME_SIZE;

float SampleDensityLow(vec3 worldPos)
{
    vec3 volumeUV =
        (worldPos - VOLUME_MIN) /
        (VOLUME_MAX - VOLUME_MIN);

    // Safety check.
    if (any(lessThan(volumeUV, vec3(0.0))) ||
        any(greaterThan(volumeUV, vec3(1.0))))
    {
        return 0.0;
    }

    return texture(
        modelingData3D,
        volumeUV).r;
}

float SampleSunTransmittance(
    vec3 worldPos,
    vec3 sunDir)
{
    float tEnter;
    float tExit;

    if (!IntersectAABB(
            worldPos,
            sunDir,
            VOLUME_MIN,
            VOLUME_MAX,
            tEnter,
            tExit))
    {
        return 1.0;
    }

    const float LIGHT_STEP_SIZE = 2.0;
    const int LIGHT_MAX_STEPS = 16;

    const float DENSITY_SCALE = 20.0;

    float lightTransmittance = 1.0;

    float t = 0.0;

    for (int i = 0;
         i < LIGHT_MAX_STEPS && t < tExit;
         ++i)
    {
        float currentStep =
            min(
                LIGHT_STEP_SIZE,
                tExit - t);

        vec3 samplePos =
            worldPos +
            sunDir *
            (t + currentStep * 0.5);

        // IMPORTANT: samplePos, not worldPos
        float density =
            SampleDensityLow(samplePos);

        float sigmaT =
            density * DENSITY_SCALE;

        float stepTransmittance =
            exp(-sigmaT * currentStep);

        lightTransmittance *=
            stepTransmittance;

        if (lightTransmittance < 0.01)
            break;

        t += currentStep;
    }

    return lightTransmittance;
}



float PhaseHenyeyGreenstein(
    float cosTheta,
    float g)
{
    const float INV_4PI = 0.0795774715;

    float g2 = g * g;

    float denom =
        1.0 + g2 - 2.0 * g * cosTheta;

    return INV_4PI *
           (1.0 - g2) /
           pow(denom, 1.5);
}



void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);

    if (pixel.x >= size.x || pixel.y >= size.y)
        return;


    // --------------------------------------------------
    // Reconstruct world-space ray
    // --------------------------------------------------

    vec2 uv =
        (vec2(pixel) + 0.5) /
        vec2(size);

    vec2 ndc = uv * 2.0 - 1.0;

    vec4 worldFar =
        global.inverseViewProj *
        vec4(ndc, 1.0, 1.0);

    worldFar.xyz /= worldFar.w;

    vec3 rayOrigin = global.cameraPos;

    vec3 rayDir =
        normalize(worldFar.xyz - rayOrigin);


    float tEnter;
    float tExit;

    float transmittance = 1.0;
    vec3 scattering = vec3(0.0);

    if (IntersectAABB(
            rayOrigin,
            rayDir,
            VOLUME_MIN,
            VOLUME_MAX,
            tEnter,
            tExit))
    {
        const float STEP_SIZE = 0.5;
        const int MAX_STEPS = 512;
        const float DENSITY_SCALE = 20.0;

        float t =
            tEnter + STEP_SIZE * 0.5;

        for (int i = 0;
             i < MAX_STEPS && t < tExit;
             ++i)
        {
            vec3 worldPos =
                rayOrigin + rayDir * t;

            float density =
                SampleDensityLow(worldPos);

            // Empty space
            if (density > 0.0001)
            {
                float sigmaT =
                    density * DENSITY_SCALE;

                float sunTransmittance =
                    SampleSunTransmittance(
                        worldPos,
                        normalize(global.sunDir));

                float cosTheta =
                    dot(
                        rayDir,
                        normalize(global.sunDir));

                float phase =
                    PhaseHenyeyGreenstein(
                        cosTheta,
                        0.6);

                float sigmaS =
                    sigmaT;

                vec3 S =
                    vec3(15.0) *
                    sigmaS *
                    sunTransmittance *
                    phase;

                float deltaTrans =
                    exp(-sigmaT * STEP_SIZE);

                float sintWeight =
                    (1.0 - deltaTrans) /
                    max(sigmaT, 1e-6);

                scattering +=
                    transmittance *
                    S *
                    sintWeight;

                transmittance *=
                    deltaTrans;
            }

            if (transmittance < 0.01)
                break;

            t += STEP_SIZE;
        }
    }


    // --------------------------------------------------
    // Visualize density
    // --------------------------------------------------

    float opacity = 1.0 - transmittance;

    float result =
        clamp(opacity, 0.0, 1.0);

    imageStore(
        outputImage,
        pixel,
        vec4(vec3(scattering), 1.0)
    );
}
