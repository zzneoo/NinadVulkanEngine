#version 460

#extension GL_GOOGLE_include_directive : require

#include "common.glsl"

#define saturate(x) clamp(x, 0.0, 1.0)

layout(local_size_x = 32, local_size_y = 32, local_size_z = 1) in;

layout(set = 1, binding = 0, rgba8) uniform writeonly image2D outputImage;
layout(set = 1, binding = 1) uniform sampler3D noise3D;
layout(set = 1, binding = 2) uniform sampler3D modelingData3D;

layout(push_constant) uniform PushConstants 
{
	vec3 v3LightColor;
	float fCloudFactor;
	vec4 fIntensity;
} pc;

// ------------------------------------------------------------
// Value Remap
// Maps a value from [oldMin, oldMax] to [newMin, newMax]
// The normalized value is clamped to [0, 1]
// ------------------------------------------------------------

float ValueRemap(
    float inValue,
    float inOldMin,
    float inOldMax,
    float inMin,
    float inMax)
{
    float oldMinMaxRange =
        inOldMax - inOldMin;

    float normalized =
        clamp(
            (inValue - inOldMin) /
            oldMinMaxRange,
            0.0,
            1.0);

    return inMin +
        normalized *
        (inMax - inMin);
}


vec2 ValueRemap(
    vec2 inValue,
    vec2 inOldMin,
    vec2 inOldMax,
    vec2 inMin,
    vec2 inMax)
{
    vec2 oldMinMaxRange =
        inOldMax - inOldMin;

    vec2 normalized =
        clamp(
            (inValue - inOldMin) /
            oldMinMaxRange,
            vec2(0.0),
            vec2(1.0));

    return inMin +
        normalized *
        (inMax - inMin);
}


vec3 ValueRemap(
    vec3 inValue,
    vec3 inOldMin,
    vec3 inOldMax,
    vec3 inMin,
    vec3 inMax)
{
    vec3 oldMinMaxRange =
        inOldMax - inOldMin;

    vec3 normalized =
        clamp(
            (inValue - inOldMin) /
            oldMinMaxRange,
            vec3(0.0),
            vec3(1.0));

    return inMin +
