}


// ------------------------------------------------------------
// Value Erosion
// Positive inOldMin = erosion
// Negative inOldMin = inflation
// ------------------------------------------------------------

float ValueErosion(
    float inValue,
    float inOldMin)
{
    float oldMinMaxRange =
        1.0 - inOldMin;

    float normalized =
        clamp(
            (inValue - inOldMin) /
            oldMinMaxRange,
            0.0,
            1.0);

    return normalized;
}

bool IntersectAABB(
    vec3 rayOrigin,
    vec3 rayDir,
    vec3 boxMin,
    vec3 boxMax,
    out float tEnter,
    out float tExit)
{
    vec3 invRayDir = 1.0 / rayDir;

    vec3 t0 =
        (boxMin - rayOrigin) * invRayDir;

    vec3 t1 =
        (boxMax - rayOrigin) * invRayDir;

    vec3 tMin =
        min(t0, t1);

    vec3 tMax =
        max(t0, t1);

    tEnter =
        max(
            max(tMin.x, tMin.y),
            tMin.z);

    tExit =
        min(
            min(tMax.x, tMax.y),
            tMax.z);

    tEnter = max(tEnter, 0.0);

    return tExit >= tEnter;
}

float SampleDensity(
    vec3 worldPos,
    vec3 sphereCenter,
    float sphereRadius)
{
    vec3 volumeUV = (worldPos - sphereCenter) / (2.0 * sphereRadius) + 0.5;

    float density = texture(noise3D, volumeUV).r;

    // Normalize distance between 0.0 and 1.0 relative to sphere radius
    float distNorm = distance(worldPos, sphereCenter) / sphereRadius;
    float falloff = smoothstep(1.0, 0.4, distNorm);

    return density * falloff;
}

const vec3 VOLUME_MIN  = vec3(-256.0, -256.0, -32.0);
const vec3 VOLUME_SIZE = vec3(512.0, 512.0, 64.0);
const vec3 VOLUME_MAX  = VOLUME_MIN + VOLUME_SIZE;
const float DENSITY_SCALE = 1.0;

float SampleDensityLow(vec3 worldPos)
{
    vec3 volumeUV =
        (worldPos - VOLUME_MIN) /
        (VOLUME_MAX - VOLUME_MIN);


    vec3 modelingData = texture(modelingData3D,volumeUV).xyz;

    vec4 noise = texture(noise3D, worldPos * 0.1).xyzw;

    // Define wispy noise
	float wispy_noise = mix(noise.r, noise.g, modelingData.r);

    // Define billowy noise 
    float billowy_type_gradient = pow(modelingData.r, 0.25);
    float billowy_noise = mix(noise.b * 0.3, noise.a * 0.3, billowy_type_gradient);

    // Define Noise composite - blend to wispy as the density scale decreases.
    float noise_composite = mix(wispy_noise, billowy_noise, modelingData.g);


    float uprezzed_density = ValueErosion(modelingData.r, noise_composite);

    // Apply User Density Scale Data to Result
    float powered_density_scale = pow(saturate(modelingData.b),4.0);

    uprezzed_density *= powered_density_scale;

    // Sharpen result and lower Density close to camera to both add details and reduce undersampling noise
    uprezzed_density = pow(uprezzed_density, mix(0.3, 0.6, max(1e-6, powered_density_scale)));


    return uprezzed_density;
}

float SampleSunTransmittance(
    vec3 worldPos,
    vec3 sunDir)
{
    float tEnter;
    float tExit;

    if (!IntersectAABB(
            worldPos,
            sunDir,
            VOLUME_MIN,
            VOLUME_MAX,
            tEnter,
            tExit))
    {
        return 1.0;
    }

    const float LIGHT_STEP_SIZE = 2.0;
    const int LIGHT_MAX_STEPS = 32;



    float lightTransmittance = 1.0;

    float t = 0.0;

    for (int i = 0; i < LIGHT_MAX_STEPS && t < tExit; ++i)
    {
        float currentStep = min( LIGHT_STEP_SIZE, tExit - t);
        vec3 samplePos = worldPos + sunDir * (t + currentStep * 0.5);

        // IMPORTANT: samplePos, not worldPos
        float density = SampleDensityLow(samplePos);
        float sigmaT = density * DENSITY_SCALE;
        float stepTransmittance = exp(-sigmaT * currentStep);

        lightTransmittance *= stepTransmittance;

        if (lightTransmittance < 0.01)
            break;

        t += currentStep;
    }

    return lightTransmittance;
}



float PhaseHenyeyGreenstein(
    float cosTheta,
    float g)
{
    const float INV_4PI = 0.0795774715;

    float g2 = g * g;

    float denom =
        1.0 + g2 - 2.0 * g * cosTheta;

    return INV_4PI *
           (1.0 - g2) /
           pow(denom, 1.5);
}

vec3 TonemapACES(vec3 x)
{
	const float a = 2.51;
	const float b = 0.03;
	const float c = 2.43;
	const float d = 0.59;
	const float e = 0.14;
	return clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0, 1.0);
}



void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);

    if (pixel.x >= size.x || pixel.y >= size.y)
        return;


    // --------------------------------------------------
    // Reconstruct world-space ray
    // --------------------------------------------------

    vec2 uv =
        (vec2(pixel) + 0.5) /
        vec2(size);

    vec2 ndc = uv * 2.0 - 1.0;

    vec4 worldFar =
        global.inverseViewProj *
        vec4(ndc, 1.0, 1.0);

    worldFar.xyz /= worldFar.w;

    vec3 rayOrigin = global.cameraPos;

    vec3 rayDir =
        normalize(worldFar.xyz - rayOrigin);


    float tEnter;
    float tExit;

    float transmittance = 1.0;
    vec3 scattering = vec3(0.0);

    if (IntersectAABB(
            rayOrigin,
            rayDir,
            VOLUME_MIN,
            VOLUME_MAX,
            tEnter,
            tExit))
    {
        const float STEP_SIZE = 0.25;
        const int MAX_STEPS = 512;

        float t = tEnter + STEP_SIZE * 0.5;

        for (int i = 0; i < MAX_STEPS && t < tExit; ++i)
        {
            vec3 worldPos = rayOrigin + rayDir * t;
            float density = SampleDensityLow(worldPos);

            // Empty space
            if (density > 0.0001)
            {
                float sigmaT = density * DENSITY_SCALE;
                float sunTransmittance = SampleSunTransmittance(worldPos,normalize(global.sunDir));
                float cosTheta = dot(rayDir, normalize(global.sunDir));
                float phase = PhaseHenyeyGreenstein(cosTheta,0.6);
                float sigmaS = sigmaT;

                // Isotropic phase function for uniform sky light (1.0 / 4PI)
                float ambientPhase = 0.079577;
                float ambientOcclusion = exp(-density * pc.fCloudFactor *10.0);

                vec3 directLight = pc.v3LightColor * pc.fIntensity.x * sunTransmittance * phase;
                vec3 ambientLight = pc.v3LightColor * ambientOcclusion * ambientPhase; // Ambient light contribution

                vec3 S =  sigmaS * (directLight + ambientLight);

                float deltaTrans = exp(-sigmaT * STEP_SIZE);
                float sintWeight = (1.0 - deltaTrans) / max(sigmaT, 1e-6);
                scattering += transmittance * S * sintWeight;
                transmittance *= deltaTrans;
            }

            if (transmittance < 0.01)
                break;

            t += STEP_SIZE;
        }
    }


    // --------------------------------------------------
    // Visualize density
    // --------------------------------------------------

    float opacity = 1.0 - transmittance;
    opacity = clamp(opacity, 0.0, 1.0);

    scattering = TonemapACES(scattering);

    imageStore(outputImage, pixel, vec4(vec3(scattering), 1.0)
    );
}
